{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "rootDirectory": "services/tasks"
  },
  "deploy": {
    "startCommand": "node dist/index.js",
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1
  },
  "volumes": [
    {
      "mount": "/data",
      "name": "gravityclaw-data"
    }
  ]
}
