# Core runtime
PORT=3000
DATABASE_PATH=./data/gravity-claw.sqlite
GC_MAX_ITERATIONS=6
GC_MAX_GROUP_ROUNDS=2
GC_DEFAULT_PROVIDER=openai
GC_DEFAULT_MODEL=gpt-4o-mini
GC_PUBLIC_BASE_URL=http://localhost:3000
GC_STRICT_ENV=false
FORGE_ENABLED=true
PROACTIVE_ENABLED=true
OLLAMA_ENABLED=true
BROWSER_AUTOMATION_ENABLED=true
SHELL_EXEC_ENABLED=true
MCP_ENABLED=true
PINECONE_ENABLED=true

# Telegram (required whitelist, long polling only)
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_ALLOWED_USER_IDS=123456789
TELEGRAM_POLL_INTERVAL_MS=1800

# Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
SERPAPI_KEY=
BRAVE_SEARCH_KEY=

# Voice + telephony
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Memory (vector DB)
PINECONE_API_KEY=
PINECONE_INDEX=gravity-claw
PINECONE_ENVIRONMENT=

# Voice STT model
WHISPER_MODEL=whisper-1

# Security
AUTH_TOKEN=                # min 50 chars, for API authentication
